{
  "name": "vidya-test-prep",
  "version": "0.1.0-local",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/check-tokens.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/check-tokens.mjs",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "reset": "tsx scripts/reset.ts",
    "regrade": "tsx scripts/regrade.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "check-tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check-tokens && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "idb-keyval": "^6.2.2",
    "jose": "^6.1.0",
    "katex": "^0.16.25",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
