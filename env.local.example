# Copy to `.env.local` if you want to pin these. BOTH ARE OPTIONAL —
# the app boots with zero configuration if this file does not exist.
#
# SESSION_SECRET signs the session cookie. Left unset, the app generates one on
# first boot and persists it to data/.session-secret. Set it explicitly if you
# want sessions to survive `npm run reset` (which wipes data/).
SESSION_SECRET=local-dev-only-change-me-b8f2c1a47e5d9036

# Where all runtime state lives. Relative paths resolve from the project root.
DATA_DIR=./data
